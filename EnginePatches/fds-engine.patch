+// FDS PATCH BEGIN (login-token redaction)
+// Login URLs carry the player's session token (playerSessionId); the join log lines show it as <redacted>.
+static FString FDSRedactLoginURL(const FString& URL)
+{
+	static const TCHAR* const Key = TEXT("playerSessionId=");
+	FString Result = URL;
+	int32 From = 0;
+	for (;;)
+	{
+		const int32 At = Result.Find(Key, ESearchCase::IgnoreCase, ESearchDir::FromStart, From);
+		if (At == INDEX_NONE)
+		{
+			return Result;
+		}
+		const int32 Start = At + FCString::Strlen(Key);
+		int32 End = Start;
+		while (End < Result.Len() && Result[End] != TEXT('?') && Result[End] != TEXT('#'))
+		{
+			++End;
+		}
+		Result = Result.Left(Start) + TEXT("<redacted>") + Result.Mid(End);
+		From = Start;
+	}
+}
